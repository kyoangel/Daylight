[
  {"id": "val_001", "text": "焦慮的感覺很耗人，能撐到這一刻已經很不容易了。",      "tags": ["anxious", "worried"],     "weight": 2},
  {"id": "val_002", "text": "擔心的時候，思緒很難停下來，這是真實的感受。",        "tags": ["anxious", "worried"],     "weight": 2},
  {"id": "val_003", "text": "你的焦慮不是沒有原因的，它有它的重量。",              "tags": ["anxious", "worried"],     "weight": 1},
  {"id": "val_004", "text": "疲憊的時候，連呼吸都需要力氣，這很正常。",            "tags": ["tired", "exhausted"],     "weight": 2},
  {"id": "val_005", "text": "身體告訴你它需要休息，這個訊號很重要。",              "tags": ["tired", "exhausted"],     "weight": 2},
  {"id": "val_006", "text": "你已經撐了很久了，疲憊是誠實的感受。",               "tags": ["tired", "exhausted"],     "weight": 1},
  {"id": "val_007", "text": "孤獨的感覺很真實，不是你想太多。",                   "tags": ["lonely", "isolated"],     "weight": 2},
  {"id": "val_008", "text": "一個人的時候特別沉，這樣的感受很多人都有過。",        "tags": ["lonely", "isolated"],     "weight": 2},
  {"id": "val_009", "text": "你不需要假裝不孤獨，這個感受值得被承認。",            "tags": ["lonely", "isolated"],     "weight": 1},
  {"id": "val_010", "text": "煩躁的時候，什麼都可能變得很難，這不是你的錯。",      "tags": ["irritable", "frustrated"],"weight": 2},
  {"id": "val_011", "text": "情緒在說話，讓它說一會兒也沒關係。",                 "tags": ["irritable", "frustrated"],"weight": 2},
  {"id": "val_012", "text": "你現在的煩躁是有原因的，不需要硬壓下去。",            "tags": ["irritable", "frustrated"],"weight": 1},
  {"id": "val_013", "text": "難過的感覺不需要被合理化，它就是真實的。",            "tags": ["sad", "low"],             "weight": 2},
  {"id": "val_014", "text": "可以先讓自己難過一下，不必立刻振作起來。",            "tags": ["sad", "low"],             "weight": 2},
  {"id": "val_015", "text": "這種感覺很重，先讓它在這裡一會兒。",                 "tags": ["sad", "low"],             "weight": 1},
  {"id": "val_016", "text": "麻木有時候是心裡在保護你，這樣也可以。",              "tags": ["numb", "detached"],       "weight": 2},
  {"id": "val_017", "text": "感覺不到什麼，也是一種感受，不需要強迫自己有情緒。",  "tags": ["numb", "detached"],       "weight": 2},
  {"id": "val_018", "text": "你現在的狀態被看見了，不用解釋。",                   "tags": ["numb", "detached"],       "weight": 1},
  {"id": "val_019", "text": "平靜是很珍貴的，讓自己好好待在這裡。",               "tags": ["calm", "peaceful"],       "weight": 2},
  {"id": "val_020", "text": "此刻的平靜值得被記住。",                             "tags": ["calm", "peaceful"],       "weight": 1},
  {"id": "val_021", "text": "還好也是一種真實的狀態，不需要更多。",                "tags": ["okay", "neutral"],        "weight": 2},
  {"id": "val_022", "text": "還好就很好，不需要給自己壓力說要感覺更強烈。",        "tags": ["okay", "neutral"],        "weight": 1},
  {"id": "val_023", "text": "不管今天的感受是什麼，你願意記錄下來，就已經是照顧自己的方式。", "tags": [], "weight": 1},
  {"id": "val_024", "text": "你的感受很真實，不需要一個理由來解釋它。",            "tags": [],                         "weight": 1},
  {"id": "val_025", "text": "此刻的你不孤單。",                                    "tags": [],                         "weight": 2},
  {"id": "val_026", "text": "開心的感覺好珍貴，讓自己好好待在裡面。",              "tags": ["happy", "joyful"],        "weight": 2},
  {"id": "val_027", "text": "快樂值得被記錄下來，就像痛苦一樣真實。",              "tags": ["happy", "joyful"],        "weight": 2},
  {"id": "val_028", "text": "你笑起來了，這很好。讓這份輕盈多停留一會兒。",        "tags": ["happy", "joyful"],        "weight": 1},
  {"id": "val_029", "text": "感恩的心讓日子變得不同，你有這樣的眼光。",            "tags": ["grateful", "thankful"],   "weight": 2},
  {"id": "val_030", "text": "能感受到感謝，是一件很溫柔的事。",                   "tags": ["grateful", "thankful"],   "weight": 2},
  {"id": "val_031", "text": "你今天注意到了美好的事物，這很值得被記住。",          "tags": ["grateful", "thankful"],   "weight": 1},
  {"id": "val_032", "text": "充實的感覺來自你真正投入了什麼，做得好。",            "tags": ["fulfilled", "content"],   "weight": 2},
  {"id": "val_033", "text": "你感到踏實，這是努力的回聲。",                       "tags": ["fulfilled", "content"],   "weight": 2},
  {"id": "val_034", "text": "這份滿足感是真實的，你值得感受它。",                  "tags": ["fulfilled", "content"],   "weight": 1},
  {"id": "val_035", "text": "這份興奮是能量，讓它帶你往前走。",                   "tags": ["excited", "energized"],   "weight": 2},
  {"id": "val_036", "text": "充滿活力的日子不常有，好好感受這份生命力。",          "tags": ["excited", "energized"],   "weight": 2},
  {"id": "val_037", "text": "幸福的時刻值得被珍藏，你正在其中。",                 "tags": ["blissful", "blessed"],    "weight": 2},
  {"id": "val_038", "text": "你感受到了幸福，這是真實且美好的。",                 "tags": ["blissful", "blessed"],    "weight": 2},
  {"id": "val_039", "text": "這種溫暖的感覺，讓它多停留一會兒，你值得。",          "tags": ["blissful", "blessed"],    "weight": 1}
]
